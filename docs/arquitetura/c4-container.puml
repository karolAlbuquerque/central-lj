@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

title Central-LJ — C4 Nível 2 (Contêineres)

Person(admin,   "ADMIN / OPERATOR", "Gerencia missões operacionais, heróis, equipes e dashboard.")
Person(hero,    "HERO",             "Cria party missions, executa puzzles e defende em duelos PvP.")
Person(villain, "VILLAIN",          "Infiltra missões heroicas, disputa duelos e aplica sabotagem.")

System_Boundary(central, "Central-LJ") {
  Container(spa, "SPA Frontend", "React 19 · TypeScript · Vite 6 — :5173", "17 páginas; 3 layouts por papel: Villain, Hero, Admin/Operator.\n10 tipos de puzzle interativos.\nVisualizador 3D GLTF via Three.js/model-viewer.\nSSE listener + polling fallback 12s + visibilitychange.\nJWT armazenado em localStorage. CSS Modules.")
  Container(api, "Backend API", "Spring Boot 3.4 · Java 21 · Maven — :8080", "12 controllers REST com 40+ endpoints.\nArquitetura Hexagonal: 19 Use Cases, 13 Ports de saída, 13 Services.\nSpring Security 6 + JWT HS256 stateless.\nProdutor Kafka: AfterCommitMissionDispatch.\nConsumidor Kafka: MissionCreatedConsumer.\nSSE emitter: SseMissionNotificationAdapter.\nFlyway migrations V1–V17.")
  ContainerQueue(kafka, "Apache Kafka (KRaft)", "Kafka KRaft · Docker — :9092", "missions.created — pipeline principal de workflow de missão.\nmissions.events — eventos gerais e debug.\nGrupo de consumidores: central-lj-backend.\nAutoStartup condicional (desabilitado no perfil test).")
  ContainerDb(pg, "PostgreSQL 16", "PostgreSQL 16 · Docker · Flyway — :5433", "11 tabelas (V1–V17):\nmissions, mission_history\nheroes, equipes_heroicas\nusuarios\nplayer_missions, mission_members\nmission_tasks\nduel_sessions, puzzle_attempts\nsabotage_events")
  Container(kafkaui, "Kafka UI", "Provectus · Docker dev — :8088", "Inspeção visual de tópicos, mensagens e consumer groups.\nApenas ambiente de desenvolvimento.")
}

Rel(admin,   spa, "Usa", "HTTPS")
Rel(hero,    spa, "Usa", "HTTPS")
Rel(villain, spa, "Usa", "HTTPS")

Rel(spa, api, "Chama endpoints REST", "HTTP/JSON")
Rel_Back(spa, api, "Recebe notificações de status", "SSE — text/event-stream")

Rel(api, kafka, "Publica MissionCreatedKafkaEvent após commit JPA", "KafkaTemplate")
Rel(kafka, api, "Entrega missions.created ao workflow de status", "MissionCreatedConsumer")

Rel(api, pg, "Persiste 11 entidades de domínio", "JPA / HikariCP")

Rel(admin, kafkaui, "Inspeciona tópicos em dev", "HTTP :8088")
Rel(kafkaui, kafka, "Administração visual", "rede Docker interna")

SHOW_LEGEND()
@enduml
