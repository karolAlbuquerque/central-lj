# Copie para infra/.env.prod e substitua todos os valores antes de publicar.
POSTGRES_PASSWORD=troque-por-uma-senha-forte
JWT_SECRET=troque-por-um-segredo-aleatorio-com-pelo-menos-32-caracteres

# Use true somente para uma publicação demonstrativa: cria as contas documentadas no README.
CENTRAL_LJ_AUTH_DEMO_SEED=false

# Porta HTTP exposta pelo servidor. Use 127.0.0.1:8080 com um proxy HTTPS externo.
HTTP_BIND=0.0.0.0:80
